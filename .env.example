# Copy to .env and fill in. Loaded automatically at startup (python-dotenv);
# real environment variables take precedence over values in this file.

# scraper = direct Google scraping, serper = Serper.dev SERP API.
# If unset: serper when SERPER_API_KEY is present, otherwise scraper.
# SEARCH_PROVIDER=serper without SERPER_API_KEY stops the app at startup.
SEARCH_PROVIDER=
SERPER_API_KEY=
# Google interface language / country
SEARCH_HL=cs
SEARCH_GL=cz
# Python logging level for the app logger
LOG_LEVEL=INFO
